# Core service secrets and static settings
SLEEPY_STATUS_SECRET=
SLEEPY_ADMIN_SECRET=
SLEEPY_GITHUB_TOKEN=
SLEEPY_ANALYTICS_SALT=
SLEEPY_HOST=0.0.0.0
SLEEPY_PORT=9010
# Only proxy headers received from this direct peer are trusted.
SLEEPY_TRUSTED_PROXY=127.0.0.1
# Number of trusted proxy hops in X-Forwarded-For (Apache only = 1).
SLEEPY_TRUSTED_PROXY_COUNT=1
SLEEPY_BLOG_BASE_URL=https://blog.tonks.top
SLEEPY_BLOG_DATA_URL=https://blog.tonks.top/data
SLEEPY_CORS_ORIGINS=
# Server-side only. Never expose this key through a VITE_ variable or browser response.
SLEEPY_SENIVERSE_API_KEY=

# Pet AI (keep real secrets only in the ignored .env file)
SLEEPY_AI_API_KEY=
SLEEPY_AI_ENDPOINT=https://api.deepseek.com/chat/completions
SLEEPY_AI_MODEL=deepseek-v4-flash
SLEEPY_AI_THINKING_ENABLED=false
SLEEPY_AI_TIMEOUT=12
SLEEPY_AI_MAX_TOKENS=180
SLEEPY_AI_SEARCH_ENABLED=true
SLEEPY_AI_MINUTE_LIMIT=4
SLEEPY_AI_DAILY_IP_LIMIT=40
SLEEPY_AI_DAILY_GLOBAL_LIMIT=500
SLEEPY_AI_DAILY_SEARCH_LIMIT=100

# Public recommendation inbox
SLEEPY_RECOMMENDATIONS_DB=
SLEEPY_RECOMMENDATION_MINUTE_LIMIT=6
# Burst protection remains in memory; the terminal command also has a persistent
# SQLite-enforced one-submission-per-day limit for non-admin visitors.
SLEEPY_RECOMMENDATION_DAILY_LIMIT=30

# Public blog likes and comments
SLEEPY_COMMUNITY_DB=
SLEEPY_COMMENT_MINUTE_LIMIT=3
SLEEPY_COMMENT_DAILY_LIMIT=20
SLEEPY_LIKE_MINUTE_LIMIT=30
# Maximum serialized history sent to comment moderation. Older records are
# represented by counts once the full history exceeds this character budget.
SLEEPY_COMMENT_HISTORY_CHARS=12000
SLEEPY_FRIEND_APPLICATION_MINUTE_LIMIT=2

# Optional explicit persistent paths (defaults remain the project root).
# Set these when deploying versioned code outside /var/sleepy:
# SLEEPY_DATA_DIR=/var/sleepy
# SLEEPY_DATA_FILE=/var/sleepy/data.json
# SLEEPY_ARTICLE_MANIFEST=/var/www/blog/community/comment-manifest.json

# Administrator email notifications (separate worker; disabled by default)
RESEND_API_KEY=
SLEEPY_NOTIFICATIONS_ENABLED=0
SLEEPY_NOTIFY_FROM="Tonks 网站通知 <notify@mail.tonks.top>"
# Comma-separated administrator mailbox addresses; required before sending
SLEEPY_NOTIFY_TO=
SLEEPY_NOTIFY_KINDS=comment,article_comment,friend_application,feedback,recommendation
SLEEPY_NOTIFY_REJECTED=1
# At least 2 seconds between delivery attempts; run exactly one worker
SLEEPY_NOTIFY_INTERVAL_SECONDS=2

# Friend RSS/Atom: defaults to friend-feeds.json beside SLEEPY_ARTICLE_MANIFEST.
# SLEEPY_FRIEND_FEEDS_MANIFEST=/var/www/blog/community/friend-feeds.json
# Cache defaults beside SLEEPY_DATA_FILE; preserve on code releases.
# SLEEPY_FRIEND_FEEDS_CACHE=/path/to/sleepy-data/friend-feeds-cache.json
