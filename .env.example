# Core service secrets and static settings
SLEEPY_STATUS_SECRET=
SLEEPY_ADMIN_SECRET=
SLEEPY_GITHUB_TOKEN=
SLEEPY_ANALYTICS_SALT=
SLEEPY_HOST=0.0.0.0
SLEEPY_PORT=9010
# Only proxy headers received from this direct peer are trusted.
SLEEPY_TRUSTED_PROXY=127.0.0.1
SLEEPY_BLOG_BASE_URL=https://blog.tonks.top
SLEEPY_BLOG_DATA_URL=https://blog.tonks.top/data
SLEEPY_CORS_ORIGINS=

# Pet AI (keep real secrets only in the ignored .env file)
SLEEPY_AI_API_KEY=
SLEEPY_AI_ENDPOINT=https://api.deepseek.com/chat/completions
SLEEPY_AI_MODEL=deepseek-v4-flash
SLEEPY_AI_THINKING_ENABLED=false
SLEEPY_AI_TIMEOUT=12
SLEEPY_AI_MAX_TOKENS=180
SLEEPY_AI_SEARCH_ENABLED=true
SLEEPY_AI_MINUTE_LIMIT=4
SLEEPY_AI_DAILY_IP_LIMIT=40
SLEEPY_AI_DAILY_GLOBAL_LIMIT=500
SLEEPY_AI_DAILY_SEARCH_LIMIT=100

# Public recommendation inbox
SLEEPY_RECOMMENDATIONS_DB=
SLEEPY_RECOMMENDATION_MINUTE_LIMIT=6
# Burst protection remains in memory; the terminal command also has a persistent
# SQLite-enforced one-submission-per-day limit for non-admin visitors.
SLEEPY_RECOMMENDATION_DAILY_LIMIT=30
