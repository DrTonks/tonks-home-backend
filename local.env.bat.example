@echo off
rem Copy this file to local.env.bat. That file is ignored by Git.

rem Absolute path to the Python interpreter used by this Windows helper.
set "SLEEPY_PYTHON=C:\Python312\python.exe"

rem Public base URL of this Flask service, without a trailing slash.
set "SLEEPY_SERVER_URL=https://status.example.com"

rem Values must match secret and admin_secret in your private data.json.
set "SLEEPY_STATUS_SECRET=replace-with-status-secret"
set "SLEEPY_ADMIN_SECRET=replace-with-admin-secret"
